-- settings
local minSpeed = 16
local maxSpeed = 120
local dragging = false

local function setSpeed(alpha)
    local speed = math.floor(minSpeed + (maxSpeed - minSpeed) * alpha)
    label.Text = "Speed: " .. speed
    if humanoid then
        humanoid.WalkSpeed = speed
    end
end

-- slider logic
bar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

    local x = math.clamp(input.Position.X - bar.AbsolutePosition.X, 0, bar.AbsoluteSize.X)
    local alpha = x / bar.AbsoluteSize.X

    fill.Size = UDim2.new(alpha,0,1,0)
    knob.Position = UDim2.new(alpha, -9, -0.4, 0)

    setSpeed(alpha)
end)

-- destroy
destroy.MouseButton1Click:Connect(function()
    gui:Destroy()
    if humanoid then
        humanoid.WalkSpeed = 16
    end
end)

-- respawn fix
player.CharacterAdded:Connect(function()
    character, humanoid = getCharacter()
end)
