local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer

------------------------------------------------
-- CHARACTER
------------------------------------------------
local function getHumanoid()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("Humanoid")
end

local humanoid = getHumanoid()

player.CharacterAdded:Connect(function()
    humanoid = getHumanoid()
end)

------------------------------------------------
-- GUI
------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "SpeedSliderFixed"
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 400, 0, 180)
frame.Position = UDim2.new(0.5, -200, 0.5, -90)
frame.BackgroundColor3 = Color3.fromRGB(20,20,25)
frame.Active = true
frame.Parent = gui
Instance.new("UICorner", frame)

------------------------------------------------
-- SAFE DRAG SYSTEM (FIXED)
------------------------------------------------
local draggingGui = false
local dragStart
local startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingGui = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingGui = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if not draggingGui then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

    local delta = input.Position - dragStart
    frame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end)

------------------------------------------------
-- TITLE
------------------------------------------------
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,30)
title.BackgroundTransparency = 1
title.Text = "Speed Slider (Fixed)"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.Parent = frame

------------------------------------------------
-- SLIDER UI
------------------------------------------------
local bar = Instance.new("Frame")
bar.Size = UDim2.new(0.8,0,0,10)
bar.Position = UDim2.new(0.1,0,0.5,0)
bar.BackgroundColor3 = Color3.fromRGB(50,50,60)
bar.Parent = frame
Instance.new("UICorner", bar)

local fill = Instance.new("Frame")
fill.Size = UDim2.new(0,0,1,0)
fill.BackgroundColor3 = Color3.fromRGB(0,170,255)
fill.Parent = bar
Instance.new("UICorner", fill)

local knob = Instance.new("Frame")
knob.Size = UDim2.new(0,16,0,16)
knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
knob.Position = UDim2.new(0,0,-0.3,0)
knob.Parent = bar
Instance.new("UICorner", knob)

------------------------------------------------
-- SETTINGS
------------------------------------------------
local minSpeed = 16
local maxSpeed = 120
local draggingSlider = false

local function setSpeed(alpha)
    local speed = math.floor(minSpeed + (maxSpeed - minSpeed) * alpha)
    if humanoid then
        humanoid.WalkSpeed = speed
    end
end

------------------------------------------------
-- SLIDER FIXED INPUT (IMPORTANT PART)
------------------------------------------------
bar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = true
    end
end)

bar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if not draggingSlider then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

    local x = math.clamp(input.Position.X - bar.AbsolutePosition.X, 0, bar.AbsoluteSize.X)
    local alpha = x / bar.AbsoluteSize.X

    fill.Size = UDim2.new(alpha,0,1,0)
    knob.Position = UDim2.new(alpha, -8, -0.3, 0)

    setSpeed(alpha)
end)
